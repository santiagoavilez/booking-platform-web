## UI LAYER (Spanish - LATAM)

### User-Facing Text

```tsx
// ✅ GOOD: Spanish for users
<Button>Reservar cita</Button>
<h1>Buscar profesionales</h1>
<p>Selecciona un horario disponible</p>

// ❌ BAD: English for LATAM users
<Button>Book appointment</Button>
<h1>Search professionals</h1>
```

### Form Labels and Placeholders

```tsx
// ✅ GOOD: Spanish labels
<Input 
  label="Correo electrónico"
  placeholder="tu@correo.com"
/>
<Input 
  label="Contraseña"
  placeholder="Ingresa tu contraseña"
/>

// ❌ BAD: English labels for LATAM
<Input label="Email" placeholder="your@email.com" />
```

### Validation Messages

```tsx
// ✅ GOOD: Spanish user messages
const validationMessages = {
  required: 'Este campo es obligatorio',
  invalidEmail: 'Ingresa un correo válido',
  minLength: 'Mínimo 8 caracteres',
};

// In Zod schemas
email: z.string()
  .min(1, 'El correo es obligatorio')
  .email('Correo electrónico inválido'),
```

### Alerts and Notifications

```tsx
// ✅ GOOD: Spanish for users
<Alert>Tu cita ha sido reservada exitosamente</Alert>
<Toast>Error al cargar los datos. Intenta de nuevo.</Toast>
```

### Page Titles and Headings

```tsx
// ✅ GOOD
<title>Reservar Cita | Booking Platform</title>
<h1>Iniciar sesión</h1>
<h2>Horarios disponibles</h2>
```

---

## Practical Example

```tsx
// ✅ CORRECT: English code, Spanish UI
function LoginForm() {
  // English: variable names, comments
  const [isLoading, setIsLoading] = useState(false);
  
  // Handle form submission
  const handleSubmit = async (data: LoginFormData) => {
    setIsLoading(true);
    try {
      await login(data);
    } catch (error) {
      // English: console logs
      console.error('Login failed:', error);
    }
  };

  return (
    <form onSubmit={handleSubmit}>
      {/* Spanish: user-facing text */}
      <h1>Iniciar sesión</h1>
      
      <Input
        label="Correo electrónico"
        placeholder="tu@correo.com"
        {...register('email')}
      />
      {errors.email && (
        <p>Ingresa un correo válido</p>
      )}
      
      <Button disabled={isLoading}>
        {isLoading ? 'Cargando...' : 'Ingresar'}
      </Button>
    </form>
  );
}
```

