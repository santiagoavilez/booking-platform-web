# Forms and Validation

## Recommended Stack

- **react-hook-form**: Form state management
- **zod**: Schema validation
- **@hookform/resolvers**: zod + react-hook-form integration

## Validation Schema with Zod

```tsx
// features/auth/schemas/login.schema.ts
import { z } from 'zod';

export const loginSchema = z.object({
  email: z
    .string()
    .min(1, 'Email is required')
    .email('Invalid email'),
  password: z
    .string()
    .min(1, 'Password is required')
    .min(8, 'Minimum 8 characters'),
});

export type LoginFormData = z.infer<typeof loginSchema>;
```

## Form with react-hook-form

```tsx
import { useForm } from 'react-hook-form';
import { zodResolver } from '@hookform/resolvers/zod';
import { loginSchema, LoginFormData } from './schemas/login.schema';

function LoginForm() {
  const {
    register,
    handleSubmit,
    formState: { errors, isSubmitting },
  } = useForm<LoginFormData>({
    resolver: zodResolver(loginSchema),
  });

  const onSubmit = async (data: LoginFormData) => {
    await login(data);
  };

  return (
    <form onSubmit={handleSubmit(onSubmit)} className="space-y-4">
      <div>
        <Input
          {...register('email')}
          type="email"
          placeholder="you@email.com"
        />
        {errors.email && (
          <p className="text-sm text-destructive mt-1">
            {errors.email.message}
          </p>
        )}
      </div>

      <div>
        <Input
          {...register('password')}
          type="password"
          placeholder="Password"
        />
        {errors.password && (
          <p className="text-sm text-destructive mt-1">
            {errors.password.message}
          </p>
        )}
      </div>

      <Button type="submit" disabled={isSubmitting} className="w-full">
        {isSubmitting ? 'Signing in...' : 'Sign in'}
      </Button>
    </form>
  );
}
```

## Input Component with Error

```tsx
// components/ui/form-input.tsx
interface FormInputProps extends React.InputHTMLAttributes<HTMLInputElement> {
  label?: string;
  error?: string;
}

export function FormInput({ label, error, className, ...props }: FormInputProps) {
  return (
    <div className="space-y-1">
      {label && (
        <label className="text-sm font-medium text-foreground">
          {label}
        </label>
      )}
      <Input
        className={cn(error && 'border-destructive', className)}
        {...props}
      />
      {error && (
        <p className="text-sm text-destructive">{error}</p>
      )}
    </div>
  );
}
```

## Common Validations

```tsx
// shared/schemas/common.schema.ts
import { z } from 'zod';

export const emailSchema = z.string().email('Invalid email');

export const passwordSchema = z
  .string()
  .min(8, 'Minimum 8 characters')
  .regex(/[A-Z]/, 'Must contain uppercase')
  .regex(/[0-9]/, 'Must contain number');

export const phoneSchema = z
  .string()
  .regex(/^\+?[0-9]{10,15}$/, 'Invalid phone number');

export const dateSchema = z.string().refine(
  (val) => !isNaN(Date.parse(val)),
  'Invalid date'
);
```

## Form with Mutation

```tsx
function BookingForm({ professionalId }: { professionalId: string }) {
  const { mutate, isPending, error } = useCreateAppointment();
  
  const form = useForm<BookingFormData>({
    resolver: zodResolver(bookingSchema),
  });

  const onSubmit = (data: BookingFormData) => {
    mutate({ ...data, professionalId });
  };

  return (
    <form onSubmit={form.handleSubmit(onSubmit)}>
      {error && <Alert variant="destructive">{error.message}</Alert>}
      {/* fields... */}
      <Button type="submit" disabled={isPending}>
        {isPending ? 'Booking...' : 'Confirm booking'}
      </Button>
    </form>
  );
}
```
