# TypeScript Standards

## Types vs Interfaces

```tsx
// ✅ Interface for objects/props (extensible)
interface UserProps {
  name: string;
  email: string;
}

// ✅ Type for unions, intersections, utilities
type UserRole = 'client' | 'professional';
type UserWithRole = User & { role: UserRole };
type OptionalUser = Partial<User>;
```

## Component Props

```tsx
// ✅ GOOD: Dedicated interface
interface ButtonProps {
  variant?: 'primary' | 'secondary';
  size?: 'sm' | 'md' | 'lg';
  children: ReactNode;
  onClick?: () => void;
}

// ✅ GOOD: Extend native props
interface InputProps extends React.InputHTMLAttributes<HTMLInputElement> {
  label?: string;
  error?: string;
}
```

## Generics

```tsx
// ✅ Reusable generic hook
function useLocalStorage<T>(key: string, initialValue: T) {
  const [value, setValue] = useState<T>(() => {
    const stored = localStorage.getItem(key);
    return stored ? JSON.parse(stored) : initialValue;
  });
  
  return [value, setValue] as const;
}

// Usage
const [user, setUser] = useLocalStorage<User | null>('user', null);
```

## Type Guards

```tsx
// ✅ Custom type guard
function isApiError(error: unknown): error is ApiError {
  return (
    error instanceof Error &&
    'statusCode' in error &&
    typeof (error as ApiError).statusCode === 'number'
  );
}

// Usage
try {
  await fetchData();
} catch (error) {
  if (isApiError(error)) {
    console.log(error.statusCode); // TypeScript knows it's ApiError
  }
}
```

## DTOs and Models

```tsx
// shared/dtos/user.dto.ts
export interface UserDTO {
  id: string;
  email: string;
  name: string;
  role: UserRole;
  createdAt: string; // ISO date string from API
}

// For forms
export interface CreateUserDTO {
  email: string;
  password: string;
  name: string;
}

// For partial updates
export interface UpdateUserDTO extends Partial<Omit<CreateUserDTO, 'email'>> {}
```

## Enums

```tsx
// shared/enums/roles.enum.ts
// ✅ PREFERRED: const object (better tree-shaking)
export const UserRole = {
  CLIENT: 'CLIENT',
  PROFESSIONAL: 'PROFESSIONAL',
} as const;

export type UserRole = typeof UserRole[keyof typeof UserRole];

// Also valid: traditional enum
export enum NotificationChannel {
  EMAIL = 'EMAIL',
  SMS = 'SMS',
  PUSH = 'PUSH',
}
```

## Strict Null Checks

```tsx
// ✅ GOOD: Handle null/undefined explicitly
function getUserName(user: User | null): string {
  return user?.name ?? 'Anonymous user';
}

// ✅ GOOD: Optional chaining with nullish coalescing
const specialty = professional?.profile?.specialty ?? 'No specialty';

// ❌ BAD: Assume it exists
const name = user.name; // Error if user is null
```

## TypeScript Utilities

```tsx
// Use built-in utilities
type UserPreview = Pick<UserDTO, 'id' | 'name' | 'email'>;
type UserWithoutId = Omit<UserDTO, 'id'>;
type MaybeUser = Partial<UserDTO>;
type RequiredUser = Required<UserDTO>;
type ReadonlyUser = Readonly<UserDTO>;
type UserRecord = Record<string, UserDTO>;
```
